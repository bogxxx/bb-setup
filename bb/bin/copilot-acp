#!/usr/bin/env bash
# macOS shim for bb's Copilot ACP launcher; the logic is in copilot-acp.mjs.
# ~/.local/bin/copilot-acp links here, so bb's provider-acp setting can use the
# bare command "copilot-acp" on every machine.
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
NODE="$(command -v node || echo /opt/homebrew/bin/node)"
exec "$NODE" "$DIR/copilot-acp.mjs" "$@"
