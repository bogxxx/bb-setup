<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Replace __LABEL__ (e.g. com.<name>.bb-loopback), __FORWARDER__ (absolute path to the
       installed forwarder, e.g. ~/Library/Application Support/bb-loopback/forward.py) and
       __LOG__ (e.g. ~/Library/Logs/bb-loopback.log). Save as ~/Library/LaunchAgents/__LABEL__.plist -->
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>__FORWARDER__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
</dict>
</plist>
